# ============================================================
# RaoMySQL / RaoCMS 环境变量配置
# 复制此文件为 .env，填入实际值
# ============================================================

# 【必需】密钥（生产环境务必修改）
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ENCRYPTION_KEY=32-byte-encryption-key-here!!

# 【可选】数据库（默认使用 SQLite）
# DATABASE_URL=sqlite+aiosqlite:///./raomysql.db

# 【AI功能】OpenAI API（可选，留空则 AI 功能不可用）
OPENAI_API_KEY=
# AI 模型（GPT-4o / GPT-4-turbo / gpt-3.5-turbo）
AI_MODEL=gpt-4o
# 如使用代理/第三方兼容 API，填写 base URL
AI_ENDPOINT=

# 【邮件通知】SMTP 配置（可选）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=RaoMySQL <noreply@example.com>

# 【安全】CORS 允许来源（逗号分隔，留空则仅允许同源）
CORS_ORIGINS=

# 【注册】是否允许公开注册
ALLOW_REGISTRATION=true
INVITE_REQUIRED=false

# 【可选】备份存储路径
# BACKUP_DIR=./backups
